# Sao chép thành .env rồi điền. Không có ElevenLabs → tự dùng Edge TTS (miễn phí).
ELEVENLABS_API_KEY=
# ID giọng: elevenlabs.io → Voices → chọn giọng → Copy voice ID
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 (rẻ, nhanh) | eleven_turbo_v2_5 | eleven_v3 (biểu cảm nhất) — các model này đều hỗ trợ tiếng Việt
ELEVENLABS_MODEL=eleven_flash_v2_5
# Ép nhà cung cấp giọng: edge | elevenlabs
# TTS=edge

# Chỉ xem số liệu công khai của kênh (không cần đăng nhập): Google Cloud → Credentials → API key
# YOUTUBE_API_KEY=

# OmniVoice server (máy PC có GPU, xem channel/research/giong-omnivoice/README.md) — dùng khi video có meta.tts: 'omnivoice'
# OMNI_URL=https://xxx.trycloudflare.com
# OMNI_KEY=
